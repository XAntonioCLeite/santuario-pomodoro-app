rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User Profiles ────────────────────────────────────────────────────────
    // Any authenticated user can read profiles (needed for visit mode & friends)
    // ── User Profiles ────────────────────────────────────────────────────────
    // Read allowed for all to enable friend searches by tag and visit mode
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Global Settings (community events, seasons) ──────────────────────────
    match /global_settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Guilds ───────────────────────────────────────────────────────────────
    match /guilds/{guildId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.leaderUid == request.auth.uid;
    }

    // ── Guestbook ────────────────────────────────────────────────────────────
    match /guestbook/{logId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── Mural de Recados ──────────────────────────────────────────────────────
    match /mural_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── Co-op Missions ───────────────────────────────────────────────────────
    match /coop_missions/{missionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── Shared Summaries (Public library) ────────────────────────────────────
    match /shared_summaries/{summaryId} {
      allow read, write: if true;
    }

    // ── Friendships & Friend Requests ────────────────────────────────────────
    match /friendships/{friendshipId} {
      allow read, write: if request.auth != null;
    }
  }
}
